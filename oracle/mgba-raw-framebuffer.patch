+static bool _mScriptCoreWriteRGBAFramebuffer(struct mCore* core, const char* filename) {
+#ifdef COLOR_16_BIT
+	UNUSED(core);
+	UNUSED(filename);
+	return false;
+#else
+	size_t stride;
+	const void* pixels = NULL;
+	unsigned width;
+	unsigned height;
+	core->currentVideoSize(core, &width, &height);
+	core->getPixels(core, &pixels, &stride);
+	if (!pixels || width > 256) {
+		return false;
+	}
+	struct VFile* vf = VFileOpen(filename, O_WRONLY | O_CREAT | O_TRUNC);
+	if (!vf) {
+		return false;
+	}
+	const mColor* input = pixels;
+	uint32_t row[256];
+	bool ok = true;
+	for (unsigned y = 0; y < height && ok; ++y) {
+		for (unsigned x = 0; x < width; ++x) {
+			row[x] = input[y * stride + x] | M_COLOR_ALPHA;
+		}
+		const size_t bytes = width * sizeof(*row);
+		ok = vf->write(vf, row, bytes) == (ssize_t) bytes;
+	}
+	ok = vf->close(vf) && ok;
+	return ok;
+#endif
+}
 #endif
 
